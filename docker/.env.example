# Copia a docker/.env (ignorado por git) y rellena. Nunca commitear valores reales.

# Secreto JWT: EL MISMO que usa ChineseReads (en local, el que pongas aquí lo reciben ambos backends).
# Generar: openssl rand -base64 48
JWT_SECRET=

# Secreto del endpoint interno premium-grant (misma regla: mismo valor en ambos proyectos).
# En local el stub WireMock espera exactamente este valor de desarrollo:
CHINESEREADS_INTERNAL_SECRET=dev-internal-secret-change-me-0123456789abcdef

# MySQL local (solo desarrollo)
MYSQL_ROOT_PASSWORD=password
ACADEMY_DB_PASSWORD=academy-dev-password

# Ruta al clon del proyecto matriz (para construir su backend y, opcionalmente, ai/tts)
CHINESEREADS_REPO_PATH=../../2025-ChineseTexts

# Solo si arrancas los servicios de IA (perfil "ai"): DEEPSEEK_API_KEY del matriz
DEEPSEEK_API_KEY=

# Stripe (vacío hasta el plan de billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_ACADEMY=
STRIPE_PRICE_TEACHER_YEARLY=
