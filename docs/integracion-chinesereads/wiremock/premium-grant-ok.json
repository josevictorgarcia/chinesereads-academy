{
  "mappings": [
    {
      "name": "premium-grant: conceder (secreto correcto)",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/api/internal/premium-grant",
        "headers": {
          "X-Service-Secret": { "equalTo": "dev-internal-secret-change-me-0123456789abcdef" },
          "Content-Type": { "contains": "application/json" }
        },
        "bodyPatterns": [
          { "matchesJsonPath": "$.userId" },
          { "matchesJsonPath": "$.until" },
          { "matchesJsonPath": "$[?(@.source == 'academy')]" }
        ]
      },
      "response": { "status": 204, "headers": { "X-Request-Id": "{{request.headers.X-Request-Id}}" }, "transformers": ["response-template"] }
    },
    {
      "name": "premium-grant: retirar (secreto correcto)",
      "priority": 1,
      "request": {
        "method": "DELETE",
        "urlPathPattern": "/api/internal/premium-grant/[0-9]+",
        "queryParameters": { "source": { "equalTo": "academy" } },
        "headers": { "X-Service-Secret": { "equalTo": "dev-internal-secret-change-me-0123456789abcdef" } }
      },
      "response": { "status": 204 }
    }
  ]
}
